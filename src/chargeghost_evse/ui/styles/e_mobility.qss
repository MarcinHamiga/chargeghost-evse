/* ChargeGhost EVSE - E-Mobility Theme */
/* Primary Accent: #1EAD98 (Electric Teal) */

* {
	font-family: "SF Pro Display", "Inter", "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
	font-size: 13px;
}

/* Main Window */
QMainWindow {
	background-color: #0d1117;
}

/* Central Widget */
QWidget {
	background-color: transparent;
	color: #e6edf3;
}

/* Labels */
QLabel {
	color: #e6edf3;
	background-color: transparent;
}

/* ============================================
   LINE EDIT
   ============================================ */

QLineEdit {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 6px;
	padding: 8px 12px;
	color: #e6edf3;
	selection-background-color: #1EAD98;
	selection-color: #0d1117;
}

QLineEdit:focus {
	border: 1px solid #1EAD98;
}

QLineEdit:disabled {
	background-color: #21262d;
	color: #8b949e;
}

QLineEdit::placeholder {
	color: #6e7681;
}

/* ============================================
   BUTTONS
   ============================================ */

QPushButton {
	background-color: #21262d;
	border: 1px solid #30363d;
	border-radius: 6px;
	padding: 10px 20px;
	color: #e6edf3;
	font-weight: 500;
	min-height: 20px;
}

QPushButton:hover {
	background-color: #30363d;
	border: 1px solid #484f58;
}

QPushButton:pressed {
	background-color: #161b22;
}

QPushButton:disabled {
	background-color: rgba(33, 38, 45, 0.2);
	color: rgba(139, 148, 158, 0.2);
	border: 1px solid rgba(48, 54, 61, 0.2);
}

QPushButton[flat="true"] {
	background-color: transparent;
	border: none;
	padding: 4px 12px;
}

QPushButton[flat="true"]:hover {
	background-color: rgba(48, 54, 61, 0.5);
}

/* Primary Action Button */
QPushButton[primary="true"],
QPushButton#btnPlug,
QPushButton#btnSaveConfig,
QPushButton#modeLaunchBtn {
	background-color: #1EAD98;
	border: 1px solid #1EAD98;
	color: #0d1117;
	font-weight: 600;
}

QPushButton[primary="true"]:hover,
QPushButton#btnPlug:hover,
QPushButton#btnSaveConfig:hover,
QPushButton#modeLaunchBtn:hover {
	background-color: #17c9a8;
	border: 1px solid #17c9a8;
}

QPushButton[primary="true"]:pressed,
QPushButton#btnPlug:pressed,
QPushButton#btnSaveConfig:pressed,
QPushButton#modeLaunchBtn:pressed {
	background-color: #159686;
}

QPushButton[primary="true"]:disabled,
QPushButton#btnPlug:disabled,
QPushButton#btnSaveConfig:disabled {
	background-color: rgba(30, 173, 152, 0.2);
	border: 1px solid rgba(30, 173, 152, 0.2);
	color: rgba(13, 17, 23, 0.2);
}

/* Success Button */
QPushButton[success="true"] {
	background-color: #238636;
	border: 1px solid #238636;
	color: #ffffff;
	font-weight: 600;
}

QPushButton[success="true"]:hover {
	background-color: #2ea043;
	border: 1px solid #2ea043;
}

QPushButton[success="true"]:pressed {
	background-color: #196c2e;
}

QPushButton[success="true"]:disabled {
	background-color: rgba(35, 134, 54, 0.2);
	border: 1px solid rgba(35, 134, 54, 0.2);
	color: rgba(255, 255, 255, 0.2);
}

/* Danger Button */
QPushButton[danger="true"],
QPushButton#btnUnplug {
	background-color: #da3633;
	border: 1px solid #da3633;
	color: #ffffff;
	font-weight: 600;
}

QPushButton[danger="true"]:hover,
QPushButton#btnUnplug:hover {
	background-color: #f85149;
	border: 1px solid #f85149;
}

QPushButton[danger="true"]:pressed,
QPushButton#btnUnplug:pressed {
	background-color: #b62324;
}

QPushButton[danger="true"]:disabled,
QPushButton#btnUnplug:disabled {
	background-color: rgba(218, 54, 51, 0.2);
	border: 1px solid rgba(218, 54, 51, 0.2);
	color: rgba(255, 255, 255, 0.2);
}

/* Toggle Details Button */
QPushButton#toggleDetailsBtn {
	background-color: transparent;
	border: none;
	color: #8b949e;
	font-size: 12px;
	padding: 4px 8px;
	text-align: left;
}

QPushButton#toggleDetailsBtn:hover {
	color: #1EAD98;
}

/* Apply Tag Button */
QPushButton#btnApplyTag {
	background-color: #21262d;
	border: 1px solid #30363d;
	color: #e6edf3;
	padding: 8px 16px;
}

QPushButton#btnApplyTag:hover {
	background-color: #30363d;
	border: 1px solid #1EAD98;
}

/* ============================================
   CHECKBOXES
   ============================================ */

QCheckBox {
	color: #e6edf3;
	spacing: 8px;
}

QCheckBox::indicator {
	width: 18px;
	height: 18px;
	border-radius: 4px;
	border: 2px solid #30363d;
	background-color: #161b22;
}

QCheckBox::indicator:hover {
	border: 2px solid #1EAD98;
}

QCheckBox::indicator:checked {
	background-color: #1EAD98;
	border: 2px solid #1EAD98;
	image: url(data:image/svg+xml;base64,);
}

QCheckBox::indicator:disabled {
	background-color: #21262d;
	border: 2px solid #21262d;
}

/* ============================================
   TAB WIDGET
   ============================================ */

QTabWidget::pane {
	border: 1px solid #30363d;
	border-radius: 8px;
	background-color: #161b22;
	margin-top: -1px;
}

QTabWidget::tab-bar {
	alignment: left;
}

QTabBar::tab {
	background-color: #21262d;
	border: 1px solid #30363d;
	border-bottom: none;
	border-top-left-radius: 6px;
	border-top-right-radius: 6px;
	padding: 8px 20px;
	margin-right: 2px;
	color: #8b949e;
	font-weight: 500;
}

QTabBar::tab:hover {
	background-color: #30363d;
	color: #e6edf3;
}

QTabBar::tab:selected {
	background-color: #161b22;
	border-bottom: 2px solid #1EAD98;
	color: #1EAD98;
}

QTabWidget#mainTabs::pane {
	border: none;
	background-color: transparent;
}

/* ============================================
   SCROLL AREA & SCROLLBAR
   ============================================ */

QScrollArea {
	background-color: transparent;
	border: none;
}

QScrollArea > QWidget > QWidget {
	background-color: transparent;
}

QScrollBar:vertical {
	background-color: #161b22;
	width: 10px;
	border-radius: 5px;
	margin: 2px;
}

QScrollBar::handle:vertical {
	background-color: #30363d;
	border-radius: 4px;
	min-height: 30px;
}

QScrollBar::handle:vertical:hover {
	background-color: #484f58;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
	height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
	background-color: transparent;
}

QScrollBar:horizontal {
	background-color: #161b22;
	height: 10px;
	border-radius: 5px;
	margin: 2px;
}

QScrollBar::handle:horizontal {
	background-color: #30363d;
	border-radius: 4px;
	min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
	background-color: #484f58;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
	width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
	background-color: transparent;
}

/* ============================================
   STATUS BAR
   ============================================ */

QStatusBar {
	background-color: #161b22;
	border-top: 1px solid #30363d;
	color: #8b949e;
	font-size: 12px;
	padding: 4px 8px;
}

/* ============================================
   LOG PANEL
   ============================================ */

LogPanel,
QTextEdit {
	background-color: #0d1117;
	border: 1px solid #30363d;
	border-radius: 8px;
	color: #e6edf3;
	font-family: "JetBrains Mono", "Fira Code", "SF Mono", "Consolas", monospace;
	font-size: 12px;
	padding: 8px;
}

QTextEdit:focus {
	border: 1px solid #1EAD98;
}

/* ============================================
   FRAMES
   ============================================ */

QFrame {
	background-color: transparent;
	border: none;
}

QFrame[frameShape="4"] {
	background-color: #30363d;
	max-height: 1px;
}

QFrame[frameShape="5"] {
	background-color: #30363d;
	max-width: 1px;
}

/* ============================================
   METRIC CARDS
   ============================================ */

QFrame[card="true"],
QFrame#metricCard {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 8px;
}

QFrame#sessionHero {
	background-color: #121923;
	border: 1px solid #2c4450;
	border-radius: 14px;
}

QFrame#sessionHero[sessionState="charging"] {
	background-color: #132028;
	border: 1px solid #1EAD98;
}

QFrame#sessionHero[sessionState="idle"] {
	background-color: #121923;
}

QFrame#sessionHero[sessionState="plugged"] {
	background-color: #15202a;
	border: 1px solid #36505c;
}

QFrame#sessionHeroContext,
QFrame#heroLimitSummary,
QFrame#telemetryPanel,
QFrame#sessionContextRail {
	background-color: #161f2a;
	border: 1px solid #2f3f4d;
	border-radius: 12px;
}

QFrame#sessionHeroMetrics,
QFrame#sessionHeroActions {
	background-color: transparent;
}

QLabel#metricTitle {
	color: #8b949e;
	font-size: 11px;
	font-weight: 600;
	text-transform: uppercase;
}

QLabel#metricValue {
	color: #1EAD98;
	font-size: 20px;
	font-weight: 700;
	font-family: "JetBrains Mono", "Fira Code", "SF Mono", monospace;
}

QLabel#metricUnit {
	color: #6e7681;
	font-size: 12px;
	font-weight: 500;
}

QLabel#heroConnectorValue {
	color: #e6edf3;
	font-size: 24px;
	font-weight: 700;
}

QLabel#heroStateValue {
	color: #8fcfc4;
	font-size: 13px;
	font-weight: 600;
}

QLabel#heroPrimaryValue {
	color: #1EAD98;
	font-size: 24px;
	font-weight: 700;
	font-family: "JetBrains Mono", "Fira Code", "SF Mono", monospace;
}

QLabel#contextLimitValue {
	color: #e6edf3;
	font-size: 16px;
	font-weight: 700;
}

QLabel#contextLimitValue[limited="true"] {
	color: #f59e0b;
}

QLabel#telemetryTitle {
	color: #e6edf3;
	font-size: 15px;
	font-weight: 700;
}

QLabel#telemetrySubtitle {
	color: #8b949e;
	font-size: 12px;
}

/* ============================================
   CONNECTOR STRIP & INDICATORS
   ============================================ */

#connectorStrip {
	background-color: transparent;
}

QFrame[connectorIndicator="true"] {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 8px;
	min-width: 100px;
}

QFrame[connectorIndicator="true"]:hover {
	border: 1px solid #1EAD98;
}

QFrame[connectorIndicator="true"][selected="true"] {
	border: 2px solid #1EAD98;
	background-color: rgba(30, 173, 152, 0.08);
}

QFrame[connectorIndicator="true"][charging="true"] {
	border-color: #1EAD98;
	background-color: rgba(30, 173, 152, 0.08);
}

QLabel#connectorIdLabel {
	color: #1EAD98;
	font-weight: 700;
	font-size: 14px;
}

QLabel#connectorStatusLabel {
	color: #8b949e;
	font-size: 11px;
	font-weight: 500;
}

QLabel#connectorHardwareLabel {
	color: #6e7681;
	font-size: 10px;
	font-weight: 500;
}

QLabel#connectorSocLabel {
	color: #1EAD98;
	font-size: 11px;
	font-weight: 700;
}

/* ============================================
   SOC SECTION
   ============================================ */

#socSection {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 8px;
}

QLabel#socTitle {
	color: #e6edf3;
	font-size: 12px;
	font-weight: 500;
}

QLabel#socPercent {
	color: #1EAD98;
	font-size: 12px;
	font-weight: 700;
	font-family: "JetBrains Mono", monospace;
}

/* ============================================
   ID TAG SECTION
   ============================================ */

#idTagSection {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 8px;
}

QLabel#idTagLabel {
	color: #8b949e;
	font-weight: 500;
}

/* ============================================
   COLLAPSIBLE DETAILS
   ============================================ */

#detailsContent {
	background-color: transparent;
}

/* ============================================
   GROUP BOXES
   ============================================ */

QGroupBox {
	border: 1px solid #30363d;
	border-radius: 8px;
	margin-top: 12px;
	padding-top: 8px;
	font-weight: 600;
	color: #1EAD98;
}

QGroupBox::title {
	subcontrol-origin: margin;
	left: 12px;
	padding: 0 8px;
	background-color: #0d1117;
	font-size: 11px;
	text-transform: uppercase;
}

/* ============================================
   CONTROL GROUPS (Manual Mode)
   ============================================ */

QFrame[controlGroup="true"] {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 8px;
}

QLabel#groupTitle {
	color: #1EAD98;
	font-weight: 600;
	font-size: 12px;
	text-transform: uppercase;
	margin-bottom: 8px;
}

/* ============================================
   MODE SELECT SCREEN
   ============================================ */

QLabel#mainTitle {
	font-size: 42px;
	font-weight: 800;
	color: #1EAD98;
}

QLabel#mainSubtitle {
	font-size: 16px;
	color: #8b949e;
	font-weight: 400;
}

QLabel#modeSelectLabel {
	color: #e6edf3;
	font-size: 14px;
	font-weight: 600;
	text-transform: uppercase;
	letter-spacing: 1px;
}

QFrame[modeCard="true"] {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 12px;
}

QFrame[modeCard="true"]:hover {
	border: 1px solid #1EAD98;
	background-color: rgba(30, 173, 152, 0.05);
}

QLabel#modeCardTitle {
	font-size: 18px;
	font-weight: 700;
	color: #e6edf3;
}

QLabel#modeCardDesc {
	color: #8b949e;
	font-size: 12px;
}

/* ============================================
   CONNECTION INDICATOR
   ============================================ */

QLabel#connection_indicator {
	padding: 4px 12px;
	border-radius: 12px;
	font-weight: 600;
	font-size: 11px;
}

QLabel#connection_indicator[connected="true"] {
	background-color: #238636;
	color: #ffffff;
}

QLabel#connection_indicator[connected="false"] {
	background-color: #da3633;
	color: #ffffff;
}

/* ============================================
   COLLAPSIBLE LOG PANEL
   ============================================ */

#collapsibleLogPanel {
	background-color: transparent;
}

#logHeader {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 8px;
}

#logContent {
	background-color: transparent;
	border: 1px solid #30363d;
	border-top: none;
	border-bottom-left-radius: 8px;
	border-bottom-right-radius: 8px;
}

#logTitle {
	color: #e6edf3;
	font-weight: 600;
	font-size: 13px;
}

#expandIcon {
	color: #8b949e;
	font-size: 10px;
}

#logCountLabel {
	color: #8b949e;
	font-size: 11px;
}

#btnLogMode,
#btnClearLog {
	background-color: transparent;
	border: none;
	color: #8b949e;
	font-size: 11px;
	padding: 4px 8px;
	min-height: 24px;
}

#btnLogMode:hover,
#btnClearLog:hover {
	color: #1EAD98;
}

#btnLogMode:checked {
	color: #1EAD98;
}

/* ============================================
   SECTION HEADERS
   ============================================ */

QLabel#sectionHeader {
	color: #e6edf3;
	font-size: 16px;
	font-weight: 700;
}

/* ============================================
   CONNECTOR PANEL
   ============================================ */

QFrame[connectorCard="true"] {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 8px;
	padding: 12px;
}

QFrame[connectorCard="true"]:hover {
	border: 1px solid #1EAD98;
}

QFrame[connectorCard="true"][selected="true"] {
	border: 2px solid #1EAD98;
	background-color: rgba(30, 173, 152, 0.08);
}

/* ============================================
   STATUS LABELS
   ============================================ */

QLabel[status="available"] {
	color: #238636;
}

QLabel[status="charging"] {
	color: #1EAD98;
}

QLabel[status="unavailable"] {
	color: #8b949e;
}

QLabel[status="faulted"] {
	color: #f85149;
}

/* ============================================
   PROGRESS BAR
   ============================================ */

QProgressBar {
	background-color: #21262d;
	border: 1px solid #30363d;
	border-radius: 4px;
	text-align: center;
	color: #e6edf3;
	font-weight: 600;
}

QProgressBar::chunk {
	background-color: #1EAD98;
	border-radius: 3px;
}

/* ============================================
   COMBO BOX
   ============================================ */

QComboBox {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 6px;
	padding: 8px 12px;
	color: #e6edf3;
}

QComboBox:hover {
	border: 1px solid #1EAD98;
}

QComboBox::drop-down {
	border: none;
	width: 24px;
}

QComboBox::down-arrow {
	image: url(data:image/svg+xml;base64,);
}

QComboBox QAbstractItemView {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 6px;
	selection-background-color: #1EAD98;
	selection-color: #0d1117;
	padding: 4px;
}

/* ============================================
   SPIN BOX
   ============================================ */

QSpinBox,
QDoubleSpinBox {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 6px;
	padding: 8px 12px;
	color: #e6edf3;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
	border: 1px solid #1EAD98;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
	background-color: #21262d;
	border: none;
	width: 20px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
	background-color: #30363d;
}

/* ============================================
   TOOLTIP
   ============================================ */

QToolTip {
	background-color: #21262d;
	border: 1px solid #30363d;
	border-radius: 4px;
	color: #e6edf3;
	padding: 6px 10px;
	font-size: 12px;
}

/* ============================================
   MENU
   ============================================ */

QMenu {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 6px;
	padding: 4px;
}

QMenu::item {
	padding: 8px 24px;
	border-radius: 4px;
	color: #e6edf3;
}

QMenu::item:selected {
	background-color: #1EAD98;
	color: #0d1117;
}

QMenu::separator {
	height: 1px;
	background-color: #30363d;
	margin: 4px 8px;
}

/* ============================================
   SPLITTER
   ============================================ */

QSplitter::handle {
	background-color: #30363d;
}

QSplitter::handle:hover {
	background-color: #1EAD98;
}

/* ============================================
   SIDEBAR NAVIGATION
   ============================================ */

#sidebar {
	background-color: #161b22;
	border-right: 1px solid #30363d;
}

#sidebarNavBtn {
	background-color: transparent;
	border: none;
	border-radius: 6px;
	padding: 10px 16px;
	color: #8b949e;
	text-align: left;
	font-weight: 500;
	font-size: 13px;
}

#sidebarNavBtn:hover {
	background-color: rgba(48, 54, 61, 0.5);
	color: #e6edf3;
}

#sidebarNavBtn:checked {
	background-color: rgba(30, 173, 152, 0.1);
	color: #1EAD98;
	font-weight: 600;
}

#sidebarNavBtn::icon {
	margin-right: 8px;
}

/* ============================================
   TOAST NOTIFICATIONS
   ============================================ */

#toastNotification {
	border-radius: 8px;
	padding: 8px 16px;
}

#toastNotification[toastType="success"] {
	background-color: rgba(35, 134, 54, 0.95);
	border: 1px solid #238636;
}

#toastNotification[toastType="error"] {
	background-color: rgba(218, 54, 51, 0.95);
	border: 1px solid #da3633;
}

#toastNotification[toastType="warning"] {
	background-color: rgba(245, 158, 11, 0.95);
	border: 1px solid #f59e0b;
}

#toastNotification[toastType="info"] {
	background-color: rgba(59, 130, 246, 0.95);
	border: 1px solid #3b82f6;
}

#toastMessage {
	color: #ffffff;
	font-size: 13px;
	font-weight: 500;
}

#toastCloseBtn {
	background-color: transparent;
	border: none;
	color: rgba(255, 255, 255, 0.7);
	padding: 0;
	min-width: 24px;
	min-height: 24px;
}

#toastCloseBtn:hover {
	color: #ffffff;
}

/* ============================================
   TOGGLE LOG BUTTON (Status Bar)
   ============================================ */

#btnToggleLog {
	background-color: transparent;
	border: 1px solid #30363d;
	border-radius: 4px;
	color: #8b949e;
	font-size: 11px;
	padding: 2px 12px;
	min-height: 20px;
}

#btnToggleLog:hover {
	border-color: #1EAD98;
	color: #1EAD98;
}

#btnToggleLog:checked {
	background-color: rgba(30, 173, 152, 0.2);
	border-color: #1EAD98;
	color: #1EAD98;
}

#btnToggleLog:disabled {
	background-color: transparent;
	border-color: rgba(48, 54, 61, 0.4);
	color: rgba(139, 148, 158, 0.5);
}

/* ============================================
   CONNECTOR EDITOR CARD (ConnectorPanel)
   ============================================ */

QFrame[connectorCard="true"] QLabel[connectorTitle="true"] {
	font-weight: 600;
	color: #1EAD98;
	font-size: 13px;
}

QFrame[connectorCard="true"] QLabel[powerLabel="true"] {
	color: #8b949e;
	font-family: monospace;
}

/* ============================================
   VALIDATION ERROR STATE
   ============================================ */

QLineEdit[validationError="true"] {
	border: 2px solid #da3633;
	background-color: rgba(218, 54, 51, 0.05);
}

QLineEdit[validationError="true"]:focus {
	border: 2px solid #f85149;
}

QLabel[validationError="true"] {
	color: #f85149;
	font-size: 11px;
}

/* ============================================
   EMPTY STATE
   ============================================ */

#emptyStateWidget {
	background-color: transparent;
}

#emptyStateIcon {
	color: #6e7681;
	font-size: 48px;
}

#emptyStateTitle {
	color: #8b949e;
	font-size: 14px;
	font-weight: 600;
}

#emptyStateDescription {
	color: #6e7681;
	font-size: 12px;
}

/* ============================================
   RECENT TAGS COMBOBOX
   ============================================ */

QComboBox#recentTagsCombo {
	background-color: #161b22;
	border: 1px solid #30363d;
	border-radius: 6px;
	padding: 8px 12px;
	padding-right: 30px;
	color: #e6edf3;
}

QComboBox#recentTagsCombo:hover {
	border: 1px solid #1EAD98;
}

QPushButton#configKeyApplyBtn {
	padding: 8px 14px;
	min-width: 72px;
}

QPushButton#configKeyApplyBtn:disabled {
	background-color: rgba(33, 38, 45, 0.4);
	color: rgba(139, 148, 158, 0.6);
	border: 1px solid rgba(48, 54, 61, 0.6);
}

/* ============================================
   CHARGING PROFILES PANEL
   ============================================ */

QLabel#profileCount {
	color: #8b949e;
	font-size: 12px;
	font-weight: 500;
}

QLabel#subsectionHeader {
	color: #e6edf3;
	font-size: 13px;
	font-weight: 600;
}

QLabel#emptyMessage {
	color: #6e7681;
	font-size: 13px;
	font-style: italic;
	padding: 16px;
}

/* Effective Limit Card */
QLabel[connectorLabel="true"] {
	color: #1EAD98;
	font-weight: 600;
	font-size: 13px;
}

QLabel[maxCurrentLabel="true"] {
	color: #8b949e;
	font-size: 12px;
}

QLabel[limitLabel="true"] {
	color: #1EAD98;
	font-weight: 600;
	font-size: 12px;
}

QLabel[limitLabel="true"][limited="true"] {
	color: #f59e0b;
}

QLabel[noLimitLabel="true"] {
	color: #6e7681;
	font-size: 12px;
}

/* Profile Card */
QLabel[profileIdLabel="true"] {
	color: #e6edf3;
	font-weight: 600;
	font-size: 13px;
}

QLabel[purposeBadge="true"] {
	font-size: 11px;
	font-weight: 500;
	padding: 2px 6px;
	background-color: rgba(255, 255, 255, 0.05);
	border-radius: 4px;
}

QLabel[profileDetail="true"] {
	color: #8b949e;
	font-size: 11px;
}

QLabel[scheduleTitle="true"] {
	color: #6e7681;
	font-size: 11px;
	font-weight: 500;
}

QLabel[periodBadge="true"] {
	color: #1EAD98;
	font-size: 11px;
	font-family: "JetBrains Mono", monospace;
	background-color: rgba(30, 173, 152, 0.1);
	padding: 2px 6px;
	border-radius: 4px;
}

QLabel[periodSeparator="true"] {
	color: #30363d;
	font-size: 11px;
}

QLabel[morePeriods="true"] {
	color: #6e7681;
	font-size: 11px;
	font-style: italic;
}

/* Scroll area for profiles */
QScrollArea#profileScrollArea {
	background-color: transparent;
	border: none;
}

/* ============================================
   UPDATE SURFACES
   ============================================ */

QDialog#updateDialog {
	background-color: #0d1117;
}

QLabel#updateDialogHeader {
	color: #1EAD98;
	font-size: 16px;
	font-weight: 700;
}

QLabel#updateDialogNotesLabel {
	color: #e6edf3;
	font-size: 13px;
	font-weight: 600;
}

QTextEdit#updateDialogReleaseNotes {
	min-height: 220px;
}

QPushButton#updateIgnoreButton {
	color: #8b949e;
}

QPushButton#updateIgnoreButton:hover {
	color: #e6edf3;
}

QPushButton#updateStatusChip {
	background-color: rgba(30, 173, 152, 0.12);
	border: 1px solid rgba(30, 173, 152, 0.45);
	border-radius: 12px;
	color: #1EAD98;
	font-size: 12px;
	font-weight: 700;
	padding: 4px 12px;
}

QPushButton#updateStatusChip:hover {
	background-color: rgba(30, 173, 152, 0.2);
	border-color: #1EAD98;
}

/* ═══════════════════════════════════════════════════════════════
   ConnectorStatusBar
═══════════════════════════════════════════════════════════════ */
#connectorStatusBar {
    background-color: #161b22;
    border-bottom: 1px solid #21262d;
}

#connectorBarLabel {
    font-size: 9px;
    color: #6e7681;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
}

#connectorPill {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 2px 8px;
    min-height: 24px;
    max-height: 24px;
}
#connectorPill:hover { border-color: #8b949e; }
#connectorPill[selected="true"] {
    background-color: rgba(30, 173, 152, 0.12);
    border-color: rgba(30, 173, 152, 0.5);
}
#connectorPill[status="charging"] { border-color: rgba(30, 173, 152, 0.4); }
#connectorPill[status="faulted"] { border-color: rgba(218, 54, 51, 0.4); }

#connectorPillLabel { font-size: 11px; color: #8b949e; }
#connectorPill[selected="true"] #connectorPillLabel { color: #1EAD98; }

#connectorBarSep { color: #30363d; max-width: 1px; min-width: 1px; }

#connectorBarStat { font-size: 11px; color: #1EAD98; font-weight: 600; }
#connectorBarStatSep { font-size: 11px; color: #484f58; }

/* ═══════════════════════════════════════════════════════════════
   LogSidePanel
═══════════════════════════════════════════════════════════════ */
#logSideTab {
    background-color: #161b22;
    border-left: 1px solid #21262d;
}
#logSideTab:hover { background-color: #1c2128; }

#logSideBadge {
    background-color: rgba(30, 173, 152, 0.2);
    color: #1EAD98;
    border-radius: 8px;
    font-size: 8px;
    padding: 1px 4px;
}

#logSidePanelContent {
    background-color: #0a0f16;
    border-left: 1px solid #21262d;
}

#logSidePanelHeader {
    background-color: #161b22;
    border-bottom: 1px solid #21262d;
}

#logSidePanelTitle { font-size: 11px; font-weight: 600; color: #e6edf3; }
#logSideCountLabel {
    font-size: 9px;
    color: #8b949e;
    background-color: #21262d;
    border-radius: 8px;
    padding: 1px 6px;
}
#btnLogSideClose { font-size: 11px; color: #6e7681; }
#btnLogSideClose:hover { color: #e6edf3; }

/* ═══════════════════════════════════════════════════════════════
   Collapsible Sidebar (SimulatorWidget / ManualWidget)
═══════════════════════════════════════════════════════════════ */
#sidebar[expanded="false"] QToolButton#sidebarNavBtn {
    min-width: 36px;
    max-width: 36px;
}
#sidebar[expanded="true"] QToolButton#sidebarNavBtn {
    min-width: 160px;
}
#sidebarExpandBtn {
    color: #6e7681;
    border: 1px solid #30363d;
    border-radius: 4px;
    min-height: 24px;
    max-height: 24px;
}
#sidebarExpandBtn:hover { color: #e6edf3; border-color: #8b949e; }

/* ═══════════════════════════════════════════════════════════════
   ContextChip (session dashboard context rail)
═══════════════════════════════════════════════════════════════ */
#contextChip {
    background-color: #161b22;
    border: 1px solid #21262d;
    border-radius: 5px;
    padding: 4px 8px;
}
#contextChipLabel {
    font-size: 8px;
    color: #6e7681;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
#contextChipValue { font-size: 12px; color: #e6edf3; font-family: monospace; }

/* ═══════════════════════════════════════════════════════════════
   Session state badge (replaces hero header)
═══════════════════════════════════════════════════════════════ */
#sessionStateBadge {
    background-color: rgba(30, 173, 152, 0.1);
    border: 1px solid rgba(30, 173, 152, 0.3);
    border-radius: 5px;
    padding: 6px 10px;
}
#sessionStateBadge[state="idle"] {
    background-color: rgba(72, 79, 88, 0.1);
    border-color: rgba(72, 79, 88, 0.3);
}
#sessionStateBadge[state="plugged"] {
    background-color: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.3);
}
#sessionStateName { font-size: 12px; font-weight: 600; color: #1EAD98; }
#sessionStateBadge[state="idle"] #sessionStateName { color: #8b949e; }
#sessionStateBadge[state="plugged"] #sessionStateName { color: #f59e0b; }
#sessionStateSub { font-size: 10px; color: #6e7681; }
